export CAPSULE_ROOT=$PWD

use flake

# `use flake` inherits nix develop's SHELL, which is stdenv's script bash — built
# without readline or progcomp. Anything that execs $SHELL rather than your login
# shell (newgrp, sg, some editors' :shell) then lands in a bash with no
# `complete` builtin and literal \[ \] in its prompt. PATH order cannot fix it;
# SHELL is an absolute store path. Put the login shell back.
SHELL="$(getent passwd "$(id -un)" | cut -d: -f7)"
export SHELL
